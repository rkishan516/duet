.DS_Store

# Phase 0 spike fixture — regenerate with:
#   flutter create --platforms=macos --project-name spike_app spikes/spike_app
#   (cd spikes/spike_app && flutter build macos --debug)
spikes/spike_app/
# ...except the hand-edited entrypoint. Spikes B and C add a platform channel,
# a post-frame reporter, and the kReloadMarker const that hot reload mutates.
# `flutter create` will NOT regenerate these, so the file is tracked explicitly.
!spikes/spike_app/lib/
!spikes/spike_app/lib/main.dart
spikes/*/target/

# Phase 2b-6 Flutter guest fixture — regenerate scaffolding (macos/, .idea/,
# pubspec.lock, ...) with:
#   flutter create --platforms=macos --org com.example --project-name duet_guest fixtures/duet_guest
#
# `/*` rather than `/`: git cannot re-include anything inside an excluded
# *directory*, so `fixtures/duet_guest/` made the `!` lines below dead letters —
# every hand-written file under it had to be forced in with `git add -f`, and a
# new one was silently skipped instead. Excluding the directory's *children*
# leaves the negations able to do their job.
fixtures/duet_guest/*
# ...except the hand-written package: the Dart guest client, its tests, the
# package manifest, and this fixture's own README. `flutter create` will NOT
# regenerate these, so they are tracked explicitly.
!fixtures/duet_guest/lib/
!fixtures/duet_guest/test/
!fixtures/duet_guest/pubspec.yaml
!fixtures/duet_guest/README.md
